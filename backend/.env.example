# Server
PORT=4000
NODE_ENV=development
API_BASE_PATH=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (local MySQL in dev, Hostinger Managed MySQL in production)
DATABASE_URL="mysql://carekart:changeme@localhost:3306/carekart"

# JWT
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Bootstrap admin (seeded once by prisma/seed.ts)
BOOTSTRAP_ADMIN_EMAIL=admin@carekart.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=CareKart Admin

# OAuth (customer sign-in)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Cloudinary (product/category/banner images, product videos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer SMTP — Hostinger mailbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="CareKart <no-reply@carekart.example>"

# PhonePe (V1 "Standard Checkout" — Salt Key + Salt Index)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT
PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
FRONTEND_ORDER_CONFIRMATION_URL=http://localhost:5173/order-confirmation

# Delhivery (courier — auto-creates a shipment when an order is confirmed)
DELHIVERY_API_TOKEN=
DELHIVERY_PICKUP_LOCATION=
DELHIVERY_SELLER_GST_TIN=
DELHIVERY_ENV=STAGING

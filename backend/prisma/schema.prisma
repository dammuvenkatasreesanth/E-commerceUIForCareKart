generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  EMPLOYEE
}

enum UserStatus {
  PENDING_CLAIM
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum AccountType {
  RETAIL
  BUSINESS
}

enum GstStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  PHONEPE
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  PHONEPE
  COD
}

enum PaymentTxnStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RECEIVED
  INSPECTED
  RESTOCKED
  WRITTEN_OFF
  REFUNDED
}

enum CouponType {
  PERCENT
  FLAT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Identity ─────────────────────────────────────────────────────────────

model User {
  id              Int         @id @default(autoincrement())
  phone           String?
  email           String?     @unique
  passwordHash    String?
  emailVerified   Boolean     @default(false)
  emailVerifiedAt DateTime?
  googleId        String?     @unique
  facebookId      String?     @unique
  avatarUrl       String?
  role            Role        @default(CUSTOMER)
  status          UserStatus  @default(ACTIVE)
  name            String?
  accountType     AccountType @default(RETAIL)
  gstin           String?
  gstStatus       GstStatus   @default(NONE)
  claimedAt       DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  addresses          Address[]
  refreshTokens      RefreshToken[]
  emailVerifications EmailVerificationToken[]
  passwordResets     PasswordResetToken[]
  staffInvitesIssued StaffInvite[]        @relation("StaffInviteIssuedBy")
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  reviews            Review[]
  orders             Order[]
  orderNotesAuthored OrderNote[]          @relation("OrderNoteAuthor")
  returnRequests     ReturnRequest[]
  refundsInitiated   Refund[]             @relation("RefundInitiatedBy")
  ticketsOwned       SupportTicket[]      @relation("TicketOwner")
  ticketsAssigned    SupportTicket[]      @relation("TicketAssignee")
  ticketNotes        TicketNote[]
  auditLogs          AuditLog[]
  campaigns          EmailCampaign[]
  contentPagesEdited ContentPage[]

  @@index([role])
}

model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model StaffInvite {
  id          Int       @id @default(autoincrement())
  userId      Int
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  issuedById  Int
  createdAt   DateTime  @default(now())

  issuedBy User @relation("StaffInviteIssuedBy", fields: [issuedById], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  userId       Int
  tokenHash    String    @unique
  userAgent    String?
  createdByIp  String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById Int?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String?
  name      String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ── Catalog ──────────────────────────────────────────────────────────────

model Category {
  id             Int        @id @default(autoincrement())
  name           String
  slug           String     @unique
  parentId       Int?
  imageUrl       String?
  isActive       Boolean    @default(true)
  showOnHomepage Boolean    @default(false)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  name              String
  tagline           String?
  description       String   @db.Text
  categoryId        Int
  price             Decimal  @db.Decimal(10, 2)
  mrp               Decimal  @db.Decimal(10, 2)
  material          String?
  badge             String?
  videoUrl          String?
  features          Json?
  specs             Json?
  moq               Int      @default(1)
  gstRate           Decimal  @db.Decimal(4, 2) @default(18.0)
  hsnCode           String?
  isActive          Boolean  @default(true)
  inStock           Boolean  @default(true)
  ratingAvg         Decimal  @db.Decimal(3, 2) @default(0)
  ratingCount       Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category      Category        @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  sizes         ProductSize[]
  packTiers     PackPriceTier[]
  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]

  @@index([categoryId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model ProductSize {
  id        Int    @id @default(autoincrement())
  productId Int
  size      String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, size])
}

model PackPriceTier {
  id          Int     @id @default(autoincrement())
  productId   Int
  tierIndex   Int
  label       String
  packQty     Int
  discountPct Decimal @db.Decimal(5, 2)
  tag         String?

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, tierIndex])
}

// ── Cart / Wishlist / Reviews ───────────────────────────────────────────

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  sizeLabel String
  tierIndex Int      @default(0)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId, sizeLabel, tierIndex])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

model Review {
  id                 Int          @id @default(autoincrement())
  productId          Int
  userId             Int
  orderId            Int?
  rating             Int
  title              String?
  body               String       @db.Text
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(APPROVED)
  helpfulCount       Int          @default(0)
  createdAt          DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([productId])
}

// ── Coupons ──────────────────────────────────────────────────────────────

model Coupon {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  type           CouponType
  value          Decimal  @db.Decimal(10, 2)
  minOrderAmount Decimal  @db.Decimal(10, 2) @default(0)
  maxUses        Int?
  usedCount      Int      @default(0)
  isActive       Boolean  @default(true)
  expiresAt      DateTime?
  createdById    Int?
  createdAt      DateTime @default(now())

  redemptions CouponRedemption[]
  orders      Order[]
}

model CouponRedemption {
  id        Int      @id @default(autoincrement())
  couponId  Int
  orderId   Int
  userId    Int
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([couponId])
}

// ── Orders / Payments / Returns ──────────────────────────────────────────

model Order {
  id                 Int           @id @default(autoincrement())
  orderNumber        String        @unique
  userId             Int
  status             OrderStatus   @default(PENDING)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(PENDING)
  subtotal           Decimal       @db.Decimal(12, 2)
  discountAmount     Decimal       @db.Decimal(12, 2) @default(0)
  shippingAmount     Decimal       @db.Decimal(12, 2) @default(0)
  taxAmount          Decimal       @db.Decimal(12, 2) @default(0)
  totalAmount        Decimal       @db.Decimal(12, 2)
  couponId           Int?

  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String

  billingGstin       String?
  billingAccountType AccountType @default(RETAIL)

  trackingId   String?
  carrier      String?
  cancelReason String?
  cancelledAt  DateTime?
  placedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  coupon        Coupon?              @relation(fields: [couponId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  notes         OrderNote[]
  payments      Payment[]
  refunds       Refund[]
  returns       ReturnRequest[]
  reviews       Review[]
  tickets       SupportTicket[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int?
  productName String
  imageUrl    String?
  sizeLabel   String
  tierIndex   Int     @default(0)
  packQty     Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)
  gstRate     Decimal @db.Decimal(4, 2)
  hsnCode     String?

  order   Order    @relation(fields: [orderId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderStatusHistory {
  id          Int          @id @default(autoincrement())
  orderId     Int
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById Int?
  note        String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderNote {
  id         Int      @id @default(autoincrement())
  orderId    Int
  authorId   Int
  isInternal Boolean  @default(true)
  note       String   @db.Text
  createdAt  DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id])
  author User  @relation("OrderNoteAuthor", fields: [authorId], references: [id])

  @@index([orderId])
}

model Payment {
  id                     Int              @id @default(autoincrement())
  orderId                Int
  provider               PaymentProvider
  merchantTransactionId  String           @unique
  providerTransactionId  String?
  amount                 Decimal          @db.Decimal(12, 2)
  status                 PaymentTxnStatus @default(INITIATED)
  rawResponse            Json?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Refund {
  id               Int          @id @default(autoincrement())
  orderId          Int
  paymentId        Int?
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?
  status           RefundStatus @default(REQUESTED)
  initiatedById    Int?
  providerRefundId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  order       Order @relation(fields: [orderId], references: [id])
  initiatedBy User? @relation("RefundInitiatedBy", fields: [initiatedById], references: [id])

  @@index([orderId])
}

model ReturnRequest {
  id              Int          @id @default(autoincrement())
  orderId         Int
  orderItemId     Int?
  userId          Int
  reason          String
  requestedQty    Int
  status          ReturnStatus @default(REQUESTED)
  inspectionNotes String?
  resolvedById    Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
}

// ── Marketing / Content / Settings ──────────────────────────────────────

model Banner {
  id               Int       @id @default(autoincrement())
  badge            String?
  headline         String
  subheadline      String?
  subtext          String?
  ctaPrimaryText   String?
  ctaPrimaryLink   String?
  ctaSecondaryText String?
  ctaSecondaryLink String?
  bgGradient       String?
  imageUrl         String?
  isActive         Boolean   @default(true)
  sortOrder        Int       @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime  @default(now())
}

model ContentPage {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  bodyHtml      String   @db.Text
  isPublished   Boolean  @default(true)
  updatedById   Int?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  updatedBy User? @relation(fields: [updatedById], references: [id])
}

model StoreSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model EmailCampaign {
  id             Int            @id @default(autoincrement())
  subject        String
  bodyHtml       String         @db.Text
  segment        Json?
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  recipientCount Int            @default(0)
  createdById    Int?
  createdAt      DateTime       @default(now())

  createdBy User? @relation(fields: [createdById], references: [id])
}

// ── Support / Audit ──────────────────────────────────────────────────────

model SupportTicket {
  id           Int            @id @default(autoincrement())
  ticketNumber String         @unique
  userId       Int
  orderId      Int?
  subject      String
  description  String         @db.Text
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  assignedToId Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User         @relation("TicketOwner", fields: [userId], references: [id])
  order      Order?       @relation(fields: [orderId], references: [id])
  assignedTo User?        @relation("TicketAssignee", fields: [assignedToId], references: [id])
  notes      TicketNote[]

  @@index([userId])
  @@index([status])
}

model TicketNote {
  id         Int      @id @default(autoincrement())
  ticketId   Int
  authorId   Int
  isInternal Boolean  @default(false)
  note       String   @db.Text
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])
  author User          @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  action     String
  entityType String
  entityId   Int?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
}
